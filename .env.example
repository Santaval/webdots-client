# Demo configuration for `npm run dev` (Vite source demo).
# Copy to `.env` (or `.env.local` for secrets) and edit. See README "Development".
# Vite only exposes vars prefixed with VITE_ to client code.

# Demo mode. `stub` (default) uses an in-memory API; `live` talks to a real
# webdots server. Can be overridden per-run via the ?mode= query param.
VITE_WEBDOTS_MODE=stub

# Required ONLY in live mode. Base URL of the annotations API.
VITE_WEBDOTS_API_URL=http://localhost:3000/api/v1

# Required for the hosted webdots server (sent as x-api-key). Omit for a
# self-hosted server with REQUIRE_API_KEY disabled, or for stub mode.
VITE_WEBDOTS_API_KEY=
